# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=webmonitor
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webmonitor?schema=public
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
CORS_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@webmonitor.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin
LOG_LEVEL=info
COOKIE_SECURE=false
TRUST_PROXY=false
MONITOR_TICK_MS=15000
LOG_RETENTION_DAYS=90
STALE_MULTIPLIER=2
NODE_ENV=development
PORT=4000

# Frontend (Docker)
FRONTEND_PORT=8080
# When serving via docker-compose nginx, set CORS_ORIGIN to match:
# CORS_ORIGIN=http://localhost:8080
